# AI Cart — 로컬 테스트 환경 변수 (로컬 Supabase Docker)
# 이 파일을 .env.test.local로 복사한 후 로컬 Supabase 인스턴스 값을 채우세요.
# .env.test.local은 절대 저장소에 커밋하지 마세요.
# npm run seed:local, npm run seed:verify:local 등 :local 스크립트가 이 파일을 로드합니다.

# 로컬 Supabase Docker URL (기본값)
SUPABASE_URL=http://localhost:54321

# 로컬 Supabase service role key
# `npx supabase status` 출력에서 확인 가능
SUPABASE_SERVICE_ROLE_KEY=<local-service-role-key>
  
# Next.js �� ���ٿ� (npm run dev:test, Playwright ���� �ʼ�)  
# SUPABASE_URL�� ���� ���� ���  
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321  
# npx supabase status ��¿��� ANON_KEY Ȯ��  
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local-anon-key> 
