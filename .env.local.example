# AI Cart — 로컬 개발 환경 변수 (원격 Supabase)
# 이 파일을 .env.local로 복사한 후 실제 값을 채우세요.
# .env.local은 절대 저장소에 커밋하지 마세요. (FR-021)

# Supabase 프로젝트 URL (공개 가능)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon key (공개 가능, RLS로 보호됨)
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase service role key — 서버 전용, 클라이언트 코드에서 절대 사용 금지 (FR-021)
# 시드 스크립트(npm run seed)와 서버 컴포넌트에서만 사용
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
